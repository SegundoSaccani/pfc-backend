# Connection string al endpoint POOLED de Neon (PgBouncer, modo transacción).
# Formato: postgresql+psycopg://<usuario>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Rol que devuelve el stub temporal de autenticación (app/core/auth.py).
# Valores validos: ADMINISTRADOR, USUARIO, FISCALIZADOR
DEFAULT_ROL=ADMINISTRADOR
